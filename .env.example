# ----------------------------------------------------------------------------
# 데이터베이스 (Neon Postgres)
# ----------------------------------------------------------------------------
# 운영(Vercel)과 로컬 개발은 서로 다른 Neon 브랜치를 사용합니다.
#   - 운영     : "main"(기본) 브랜치  → Vercel 환경변수에 설정
#   - 로컬 개발: "dev" 브랜치         → 이 .env 에 설정
#
# DATABASE_URL : 앱 런타임 연결 (Neon "Pooled connection", 호스트에 -pooler 포함)
# DIRECT_URL   : 마이그레이션(DDL) 연결 (Neon "Direct connection", -pooler 없음)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ----------------------------------------------------------------------------
# 세션 서명 키 (생성: openssl rand -base64 32) — 운영/로컬 다른 값 권장
# ----------------------------------------------------------------------------
SESSION_SECRET="generate-a-32-byte-random-string"
