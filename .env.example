# ----------------------------------------------------------------------------
# 데이터베이스 (Neon Postgres 권장)
# ----------------------------------------------------------------------------
# DATABASE_URL : 앱 런타임에서 사용하는 연결 문자열 (Neon 의 "Pooled connection")
# DIRECT_URL   : 마이그레이션(DDL)에서 사용하는 비풀링 연결 문자열 (Neon 의 "Direct connection")
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------------------------
# 세션 서명 키 (아래 명령으로 생성: openssl rand -base64 32)
# ----------------------------------------------------------------------------
SESSION_SECRET="generate-a-32-byte-random-string"
